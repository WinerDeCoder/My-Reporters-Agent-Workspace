# Copy to .env and fill in. Never commit .env.

# Reporters Postgres in Docker (matches docker-compose.yml defaults; host port 5433, Q-024)
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar
POSTGRES_DB=radar
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://radar:radar@localhost:5433/radar

# GitHub personal access token (no scopes needed for public repos)
GITHUB_TOKEN=

# OpenAI API key for card generation (model settings are in config.yaml -> llm)
OPENAI_API_KEY=
